# Copiar a backend/.env (nunca commitear con secretos reales).
# Contrato: Portal-Paldaca/docs/PALDACA_SUITE/CONTRATO_SSO_FEDERADO.md

# Sin DEBUG (producción) el arranque exige una clave propia de >= 40 caracteres.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Por defecto es false (seguro): en local hay que ponerlo en true.
DJANGO_DEBUG=true
# Solo producción (sin DEBUG valen true / 31536000); aquí no aplican.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5181,http://localhost:8007

# Base de datos: vacía = SQLite local (backend/db.sqlite3). En producción, MySQL
# PROPIA (nunca la del Portal); el contenedor no arranca sin ella.
# DATABASE_URL=mysql://usuario:clave@host:3306/planificacion
# Registros propios (planificacion.*, paldaca.*): DEBUG, INFO, WARNING...
# LOG_LEVEL=INFO

# Vite dev server del frontend de Planificación (ver frontend/vite.config.ts).
# Sin DEBUG queda vacío por defecto: en producción la SPA es del mismo origen.
CORS_ALLOWED_ORIGINS=http://localhost:5181

# --- SSO federado: apagado por defecto (deploy dark) -----------------------
PALDACA_SSO_ENABLED=false
PALDACA_MODULO_CODIGO=planificacion
PALDACA_PORTAL_URL=http://localhost:5173
PALDACA_PORTAL_API_URL=http://localhost:8000
PALDACA_SSO_PORTAL_COOKIE_NAME=paldaca_sessionid
PALDACA_SSO_LOGIN_URL=http://localhost:5173/login

# --- Avisos en la campana del Portal ---------------------------------------
# Secreto PROPIO (>= 32 caracteres), el mismo que PALDACA_NOTIF_SECRET_PLANIFICACION
# del Portal. El arranque de la Suite (iniciar.ps1) lo genera en local.
PALDACA_NOTIFICACIONES_ACTIVAS=true
PALDACA_NOTIF_SECRET=

# --- Sesión local de Planificación (NUNCA paldaca_sessionid, ver checks.py) --
SESSION_COOKIE_NAME=planificacion_sessionid
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false

# --- Contrato paldaca-embed v1 ---------------------------------------------
PALDACA_SHELL_PATH=/planificacion
# Sin comillas a proposito: python-dotenv (y los paneles de env vars tipo
# Coolify) se comen o parten las comillas. `embed.py` repone las que exige
# el CSP, convirtiendo `self` en `'self'` antes de emitir la cabecera.
PALDACA_FRAME_ANCESTORS=self http://localhost:5173
